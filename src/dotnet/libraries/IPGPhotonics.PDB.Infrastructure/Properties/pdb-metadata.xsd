				<xs:element name="Module.Name" type="xs:string"/>
				<xs:element name="Module.Description" type="xs:string" minOccurs="0"/>
			</xs:all>
			<xs:attribute name="Label" type="xs:string" use="required"/>
			<xs:attribute name="OID" type="xs:integer" use="required"/>
			<xs:attribute name="UUID" type="uuid" use="required"/>
			<xs:attribute name="CreatedDate" type="xs:dateTime"/>
			<xs:attribute name="ModifiedDate" type="xs:dateTime"/>
			<xs:attribute name="CreatedBy" type="user-ref"/>
			<xs:attribute name="ModifiedBy" type="user-ref"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="uuid">
		<xs:restriction base="xs:string">
			<xs:pattern value="\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}"/>
