<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" xmlns:ns="urn:schemas.ipg.corp:pdb:metadata" elementFormDefault="qualified" attributeFormDefault="unqualified" vc:minVersion="1.1">
	<xs:element name="Class">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Class.ClassName" type="xs:string" minOccurs="0"/>
				<xs:element name="Class.ShortNameMask" type="xs:string" minOccurs="0"/>
				<xs:element name="Class.NewItemText" minOccurs="0"/>
				<xs:element name="Class.DefaultListPeriod" type="ListPeriod" minOccurs="0"/>
				<xs:element name="Class.DisableDirectAdd" type="xs:boolean" default="false" minOccurs="0"/>
				<xs:element name="Class.DisableDirectDelete" type="xs:boolean" default="false" minOccurs="0"/>
				<xs:element name="Class.DisableCopying" type="xs:boolean" default="false" minOccurs="0"/>
				<xs:element name="Class.SpellCheckingDisabled" type="xs:boolean" default="false" minOccurs="0"/>
				<xs:element name="Class.AlwaysReadOnly" type="xs:boolean" default="false" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Identity"/>
			<xs:attribute name="ClassLabel" use="required"/>
			<xs:attribute name="ClassName"/>
			<xs:attribute name="ShortNameMask"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="ListPeriod">
		<xs:restriction base="xs:string">
			<xs:enumeration value="None"/>
			<xs:enumeration value="Day"/>
			<xs:enumeration value="Month"/>
			<xs:enumeration value="Year"/>
			<xs:enumeration value="Custom"/>
			<xs:enumeration value="All"/>
			<xs:enumeration value="Week"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Module">
		<xs:complexType>
